DATABASE_URL="postgresql://usuario:password@host:5432/celedimaquinaria"
DIRECT_URL="postgresql://usuario:password@host:5432/celedimaquinaria"
AUTH_SECRET="genera-un-valor-con: openssl rand -base64 32"

# Opcional en desarrollo local: sin este valor, las fotos de Área de Daños
# se guardan en public/uploads/. En Vercel es obligatorio para que las
# fotos persistan (ver sección "Desplegar en Vercel" del README).
BLOB_READ_WRITE_TOKEN=""

# Solo necesaria para sembrar los usuarios demo vía /api/seed?key=...
# (ver sección "Desplegar en Vercel" del README). Bórrala de Vercel
# después de usarla una vez.
SEED_SECRET="genera-un-valor-con: openssl rand -hex 20"

# Opcional: corte automático de periodo de prueba. Con esta fecha puesta
# (formato ISO, ej. "2026-09-29T06:00:00Z"), nadie puede entrar después —
# ni con sesión ya iniciada — y se muestra un aviso en vez del login.
# Bórrala (o muévela a futuro lejano) y vuelve a desplegar para activar el
# sistema en definitivo, sin tocar código. Ver "Notas sobre el periodo de
# prueba" en el README.
NEXT_PUBLIC_TRIAL_HASTA=""
