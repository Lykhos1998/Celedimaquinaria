// Celedi Maquinaria — esquema de datos
// PostgreSQL. `url` acepta una conexión con pooling (p. ej. pgbouncer);
// `directUrl` debe ser una conexión directa, usada solo para migraciones.
// Si el proveedor solo da una URL, usa el mismo valor en ambas variables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Roles definidos en la especificación funcional (sección 5, "Roles y permisos").
// GERENCIA tiene alcance global sobre todos los módulos.
enum Rol {
  VIGILANTE
  MARKETING
  ASESOR_VENTAS
  INSPECTOR_DANOS
  COMPRAS
  TALLER
  FINANZAS
  LOGISTICA
  RH
  SISTEMAS_TI
  GERENCIA
}

model User {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String
  rol          Rol
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Vigilancia — registros donde este usuario es el colaborador checado
  asistencias           AsistenciaRegistro[] @relation("Colaborador")
  // Vigilancia — registros que este usuario (vigilante) capturó
  asistenciasRegistradas AsistenciaRegistro[] @relation("RegistradoPor")

  qrVehiculosRegistrados QRVehiculo[]

  valesComoSolicitante ValeSalida[] @relation("Solicitante")
  valesAutorizados     ValeSalida[] @relation("AutorizadoPor")
  valesValidados       ValeSalida[] @relation("ValidadoPor")

  incidentesRegistrados IncidenteSeguridad[]

  // Comercial — leads que este usuario (asesor de ventas) tiene asignados
  leadsAsignados Lead[] @relation("AsesorLead")
  // Comercial — leads que este usuario (marketing) capturó
  leadsCreados   Lead[] @relation("CreadoPorLead")

  gastosPublicitarios GastoPublicitario[]

  contratos Contrato[]

  equiposActualizados Equipo[]

  ordenesCreadas         OrdenServicio[]
  refaccionesSolicitadas SolicitudRefaccion[]

  ordenesCompraRegistradas OrdenCompra[] @relation("OrdenCompraRegistradaPor")
  ordenesCompraAprobadas   OrdenCompra[] @relation("OrdenCompraAprobadaPor")
  ordenesCompraPagadas     OrdenCompra[] @relation("OrdenCompraPagadaPor")

  trasladosProgramados Traslado[]

  reportesInspeccionados ReporteInspeccion[]
  danosRegistrados       Danio[]

  cuentasCobrarRegistradas CuentaCobrar[] @relation("CuentaCobrarRegistradaPor")
  cuentasCobrarCobradas    CuentaCobrar[] @relation("CuentaCobrarCobradaPor")

  // RH — expediente propio (como colaborador) y acciones que este usuario
  // (rol RH) realizó sobre expedientes de otros
  permisos             Permiso[] @relation("PermisoColaborador")
  permisosRegistrados  Permiso[] @relation("PermisoRegistradoPor")
  permisosResueltos    Permiso[] @relation("PermisoResueltoPor")
  nominas              Nomina[]  @relation("NominaColaborador")
  nominasGeneradas     Nomina[]  @relation("NominaGeneradoPor")
  nominasPagadas       Nomina[]  @relation("NominaPagadaPor")

  // Sistemas / TI
  ticketsReportados  TicketSoporte[] @relation("TicketReportadoPor")
  ticketsResueltos   TicketSoporte[] @relation("TicketResueltoPor")
  dispositivosAsignados Dispositivo[] @relation("DispositivoColaborador")
  dispositivosDadosDeAlta Dispositivo[] @relation("DispositivoAsignadoPor")
}

// --- Módulo Vigilancia --------------------------------------------------

enum TipoChecada {
  ENTRADA
  SALIDA
  ENTRADA_COMIDA
  SALIDA_COMIDA
}

model AsistenciaRegistro {
  id             String      @id @default(cuid())
  colaborador    User        @relation("Colaborador", fields: [colaboradorId], references: [id])
  colaboradorId  String
  tipo           TipoChecada
  timestamp      DateTime    @default(now())
  registradoPor  User        @relation("RegistradoPor", fields: [registradoPorId], references: [id])
  registradoPorId String

  @@index([colaboradorId])
}

enum MovimientoQR {
  SALIDA
  LLEGADA
}

model QRVehiculo {
  id              String       @id @default(cuid())
  placa           String
  codigoQR        String
  movimiento      MovimientoQR
  destino         String?
  timestamp       DateTime     @default(now())
  registradoPor   User         @relation(fields: [registradoPorId], references: [id])
  registradoPorId String

  @@index([placa])
}

enum EstadoVale {
  SOLICITADO
  AUTORIZADO
  EN_SALIDA
  RETORNADO
  VENCIDO
}

model ValeSalida {
  id              String     @id @default(cuid())
  folio           String     @unique
  activo          String
  solicitante     User       @relation("Solicitante", fields: [solicitanteId], references: [id])
  solicitanteId   String
  autorizadoPor   User?      @relation("AutorizadoPor", fields: [autorizadoPorId], references: [id])
  autorizadoPorId String?
  validadoPor     User?      @relation("ValidadoPor", fields: [validadoPorId], references: [id])
  validadoPorId   String?
  estado          EstadoVale @default(SOLICITADO)
  fechaSalida     DateTime?
  fechaRetorno    DateTime?
  createdAt       DateTime   @default(now())

  // Si el vale sale de Sistemas/TI (equipo de cómputo), queda ligado al
  // activo de su catálogo; Vigilancia sigue siendo quien valida la salida
  // física sin importar el origen del vale.
  dispositivo   Dispositivo? @relation(fields: [dispositivoId], references: [id])
  dispositivoId String?
}

enum SeveridadIncidente {
  BAJA
  MEDIA
  ALTA
}

model IncidenteSeguridad {
  id              String             @id @default(cuid())
  descripcion     String
  severidad       SeveridadIncidente @default(BAJA)
  timestamp       DateTime           @default(now())
  registradoPor   User               @relation(fields: [registradoPorId], references: [id])
  registradoPorId String
}

// --- Módulo Comercial (Marketing + Ventas) ------------------------------

enum CanalLead {
  REDES_SOCIALES
  COTIZACION_DIRECTA
  TELEFONO
  FORMULARIO_WEB
}

enum TipoTrabajo {
  RENTA
  VENTA
}

// Etapas del pipeline pre-venta, más los dos cierres posibles (GANADO/PERDIDO).
enum EtapaLead {
  LEAD_NUEVO
  CALIFICADO
  CONTACTADO
  PROPUESTA
  NEGOCIACION
  GANADO
  PERDIDO
}

enum Temperatura {
  FRIO
  TIBIO
  CALIENTE
}

model Lead {
  id            String      @id @default(cuid())
  folio         String      @unique // EXP-XXXX
  nombre        String
  telefono      String?
  email         String?
  canal         CanalLead
  tipoTrabajo   TipoTrabajo
  ubicacion     String?
  valorEstimado Float?
  etapa         EtapaLead   @default(LEAD_NUEVO)
  temperatura   Temperatura @default(TIBIO)
  motivoPerdida String?
  valorPerdido  Float?

  asesor   User?   @relation("AsesorLead", fields: [asesorId], references: [id])
  asesorId String?

  creadoPor   User   @relation("CreadoPorLead", fields: [creadoPorId], references: [id])
  creadoPorId String

  createdAt DateTime  @default(now())
  cerradoAt DateTime?

  contrato Contrato?

  @@index([canal])
  @@index([etapa])
  @@index([asesorId])
}

model GastoPublicitario {
  id         String     @id @default(cuid())
  plataforma String
  canal      CanalLead?
  monto      Float
  fecha      DateTime   @default(now())

  registradoPor   User   @relation(fields: [registradoPorId], references: [id])
  registradoPorId String
}

model Contrato {
  id           String   @id @default(cuid())
  folio        String   @unique // CTR-AAAA-XXXX
  lead         Lead     @relation(fields: [leadId], references: [id])
  leadId       String   @unique
  asesor       User     @relation(fields: [asesorId], references: [id])
  asesorId     String
  valorMensual Float
  fechaInicio  DateTime
  fechaFin     DateTime
  cancelado    Boolean  @default(false)
  createdAt    DateTime @default(now())

  // Unidad de flota asignada a la renta, si aplica (un contrato puede ser
  // de venta o no traer aún equipo asignado).
  equipo   Equipo? @relation(fields: [equipoId], references: [id])
  equipoId String?

  reportesInspeccion ReporteInspeccion[]
  cuentasCobrar      CuentaCobrar[]
}

// --- Módulo Equipos / Flota (transversal) -------------------------------

enum EstadoEquipo {
  DISPONIBLE
  RENTADO
  EN_TRANSITO
  EN_MANTENIMIENTO
  FUERA_DE_SERVICIO
}

enum Combustible {
  DIESEL
  GASOLINA
  ELECTRICO
  GAS
}

// Tarifario centralizado por marca/modelo/clasificación, usado por Ventas
// al cotizar. Varias unidades físicas (Equipo) pueden compartir una tarifa.
model TarifaEquipo {
  id               String   @id @default(cuid())
  marca            String
  modelo           String
  clasificacion    String
  alturaCapacidad  String?
  precioMensual    Float
  precioDia1       Float
  precioDia7       Float
  precioDia15      Float
  createdAt        DateTime @default(now())

  equipos Equipo[]
}

model Equipo {
  id          String       @id @default(cuid())
  codigo      String       @unique // EQ-0001, también el valor codificado en el QR físico
  marca       String
  modelo      String
  anio        Int
  numeroSerie String?
  categoria   String
  combustible Combustible
  altura      Float?
  horometro   Float        @default(0)
  estado      EstadoEquipo @default(DISPONIBLE)

  tarifa   TarifaEquipo? @relation(fields: [tarifaId], references: [id])
  tarifaId String?

  actualizadoPor   User?   @relation(fields: [actualizadoPorId], references: [id])
  actualizadoPorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contratos          Contrato[]
  ordenesServicio    OrdenServicio[]
  traslados          Traslado[]
  reportesInspeccion ReporteInspeccion[]

  @@index([estado])
  @@index([categoria])
}

// --- Módulo Taller -------------------------------------------------------

enum TipoServicio {
  PREVENTIVO
  CORRECTIVO
}

enum EstadoOrdenServicio {
  ABIERTA
  EN_PROCESO
  ESPERANDO_REFACCION
  COMPLETADA
  CANCELADA
}

model OrdenServicio {
  id          String              @id @default(cuid())
  folio       String              @unique // OS-0001
  equipo      Equipo              @relation(fields: [equipoId], references: [id])
  equipoId    String
  tipo        TipoServicio
  descripcion String
  estado      EstadoOrdenServicio @default(ABIERTA)

  creadoPor   User   @relation(fields: [creadoPorId], references: [id])
  creadoPorId String

  fechaInicio DateTime  @default(now())
  fechaFin    DateTime?
  createdAt   DateTime  @default(now())

  refacciones SolicitudRefaccion[]

  // Reporte de inspección de Área de Daños que originó esta orden correctiva,
  // si aplica.
  reporteInspeccion   ReporteInspeccion? @relation(fields: [reporteInspeccionId], references: [id])
  reporteInspeccionId String?

  @@index([equipoId])
  @@index([estado])
  @@index([reporteInspeccionId])
}

enum EstadoRefaccion {
  SOLICITADA
  RECIBIDA
  CANCELADA
}

// Modela únicamente el lado de Taller del flujo ("Taller solicita"); la
// cotización de Compras y la aprobación de Dirección se agregarán cuando
// se construya el módulo de Compras.
model SolicitudRefaccion {
  id              String          @id @default(cuid())
  ordenServicio   OrdenServicio   @relation(fields: [ordenServicioId], references: [id])
  ordenServicioId String
  descripcion     String
  cantidad        Int             @default(1)
  estado          EstadoRefaccion @default(SOLICITADA)

  solicitadoPor   User   @relation(fields: [solicitadoPorId], references: [id])
  solicitadoPorId String

  createdAt DateTime @default(now())

  ordenCompra OrdenCompra?
}

// --- Módulo Compras -------------------------------------------------------

model Proveedor {
  id        String   @id @default(cuid())
  nombre    String
  contacto  String?
  telefono  String?
  email     String?
  categoria String?
  createdAt DateTime @default(now())

  ordenesCompra OrdenCompra[]
}

enum EstadoOrdenCompra {
  PENDIENTE_APROBACION
  APROBADA
  RECHAZADA
  RECIBIDA
}

// Área que origina la compra. TALLER normalmente viene ligada a una
// SolicitudRefaccion; RH y SISTEMAS_TI son compras directas cuyo detalle
// aún no se define (ver especificación, sección 3.5, "punto abierto").
enum AreaSolicitante {
  TALLER
  RH
  SISTEMAS_TI
  OTRO
}

model OrdenCompra {
  id          String            @id @default(cuid())
  folio       String            @unique // OC-AAAA-XXXX
  proveedor   Proveedor         @relation(fields: [proveedorId], references: [id])
  proveedorId String
  descripcion String
  monto       Float
  area        AreaSolicitante
  estado      EstadoOrdenCompra @default(PENDIENTE_APROBACION)

  // Solicitud de refacción de Taller que originó esta compra, si aplica.
  refaccion   SolicitudRefaccion? @relation(fields: [refaccionId], references: [id])
  refaccionId String?             @unique

  registradoPor   User   @relation("OrdenCompraRegistradaPor", fields: [registradoPorId], references: [id])
  registradoPorId String

  // Dirección aprueba siempre, sin importar el monto (ver especificación).
  aprobadoPor     User?     @relation("OrdenCompraAprobadaPor", fields: [aprobadoPorId], references: [id])
  aprobadoPorId   String?
  fechaAprobacion DateTime?

  // Cuenta por pagar (Finanzas). Independiente del estado de la orden: una
  // orden aprobada o recibida puede tardar en pagarse.
  pagada      Boolean   @default(false)
  fechaPago   DateTime?
  pagadoPor   User?     @relation("OrdenCompraPagadaPor", fields: [pagadoPorId], references: [id])
  pagadoPorId String?

  createdAt DateTime @default(now())

  @@index([estado])
  @@index([area])
}

// --- Módulo Logística ------------------------------------------------------

model Camion {
  id        String   @id @default(cuid())
  placa     String   @unique
  modelo    String?
  capacidad String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  traslados Traslado[]
}

enum TipoMovimiento {
  ENTREGA
  RECOLECCION
}

enum EstadoTraslado {
  PROGRAMADO
  EN_TRANSITO
  ENTREGADO
  CANCELADO
}

model Traslado {
  id             String         @id @default(cuid())
  folio          String         @unique // TR-0001
  equipo         Equipo         @relation(fields: [equipoId], references: [id])
  equipoId       String
  camion         Camion         @relation(fields: [camionId], references: [id])
  camionId       String
  tipoMovimiento TipoMovimiento
  origen         String
  destino        String
  estado         EstadoTraslado @default(PROGRAMADO)

  fechaProgramada DateTime
  fechaSalida     DateTime?
  fechaEntrega    DateTime?

  programadoPor   User   @relation(fields: [programadoPorId], references: [id])
  programadoPorId String

  createdAt DateTime @default(now())

  @@index([estado])
  @@index([equipoId])
  @@index([camionId])
}

// --- Módulo Área de Daños -------------------------------------------------

model ReporteInspeccion {
  id       String @id @default(cuid())
  folio    String @unique // INS-0001
  equipo   Equipo @relation(fields: [equipoId], references: [id])
  equipoId String

  // Contrato de renta que regresa, si la inspección viene de una devolución.
  contrato   Contrato? @relation(fields: [contratoId], references: [id])
  contratoId String?

  observaciones String?

  inspeccionadoPor   User   @relation(fields: [inspeccionadoPorId], references: [id])
  inspeccionadoPorId String

  createdAt DateTime @default(now())

  danos           Danio[]
  ordenesServicio OrdenServicio[]

  @@index([equipoId])
  @@index([contratoId])
}

enum SeveridadDanio {
  LEVE
  MODERADA
  GRAVE
}

model Danio {
  id        String            @id @default(cuid())
  reporte   ReporteInspeccion @relation(fields: [reporteId], references: [id])
  reporteId String
  tipo      String
  severidad SeveridadDanio    @default(LEVE)
  descripcion   String?
  fotoUrl       String?
  costoEstimado Float?

  registradoPor   User   @relation(fields: [registradoPorId], references: [id])
  registradoPorId String

  createdAt DateTime @default(now())

  cuentaCobrar CuentaCobrar?

  @@index([reporteId])
}

// --- Módulo Finanzas -------------------------------------------------------

enum ConceptoCobro {
  RENTA_MENSUAL
  DANO
  OTRO
}

// El estado real (Pendiente/Vencida/Cobrada) se deriva de `cobrada` y
// `fechaVencimiento` en src/lib/finanzas.ts, igual que EstadoContrato — así
// no depende de un job para marcar vencimientos.
model CuentaCobrar {
  id          String        @id @default(cuid())
  folio       String        @unique // CXC-AAAA-XXXX
  concepto    ConceptoCobro
  descripcion String
  monto       Float
  cobrada     Boolean       @default(false)

  // Origen del cobro: una renta mensual (ligada al contrato) o un daño
  // (ligado al hallazgo de Área de Daños). Ambos opcionales porque también
  // se puede registrar un cobro manual ("OTRO") sin origen en el sistema.
  contrato   Contrato? @relation(fields: [contratoId], references: [id])
  contratoId String?

  danio   Danio?  @relation(fields: [danioId], references: [id])
  danioId String? @unique

  fechaVencimiento DateTime
  fechaCobro       DateTime?

  registradoPor   User   @relation("CuentaCobrarRegistradaPor", fields: [registradoPorId], references: [id])
  registradoPorId String
  cobradoPor      User?  @relation("CuentaCobrarCobradaPor", fields: [cobradoPorId], references: [id])
  cobradoPorId    String?

  createdAt DateTime @default(now())

  @@index([contratoId])
  @@index([cobrada])
}

// --- Módulo RH ---------------------------------------------------------
// Alcance confirmado como estándar en la especificación (sección 3.9): recibe
// asistencia de Vigilancia, gestiona permisos/vacaciones, nómina con base en
// esa asistencia, y expediente de colaborador (altas/bajas — el "expediente"
// documental completo queda fuera de este alcance estándar).

enum TipoPermiso {
  VACACIONES
  PERMISO
  INCAPACIDAD
  OTRO
}

enum EstadoPermiso {
  SOLICITADO
  APROBADO
  RECHAZADO
}

model Permiso {
  id          String        @id @default(cuid())
  folio       String        @unique // PER-0001
  colaborador User          @relation("PermisoColaborador", fields: [colaboradorId], references: [id])
  colaboradorId String
  tipo        TipoPermiso
  fechaInicio DateTime
  fechaFin    DateTime
  motivo      String?
  estado      EstadoPermiso @default(SOLICITADO)

  registradoPor   User    @relation("PermisoRegistradoPor", fields: [registradoPorId], references: [id])
  registradoPorId String
  resueltoPor     User?   @relation("PermisoResueltoPor", fields: [resueltoPorId], references: [id])
  resueltoPorId   String?

  createdAt DateTime @default(now())

  @@index([colaboradorId])
  @@index([estado])
}

// Los días asistidos se calculan a partir de AsistenciaRegistro (checadas de
// ENTRADA en el periodo), no se capturan a mano — así siempre refleja lo que
// Vigilancia realmente registró.
model Nomina {
  id            String   @id @default(cuid())
  folio         String   @unique // NOM-AAAA-XXXX
  colaborador   User     @relation("NominaColaborador", fields: [colaboradorId], references: [id])
  colaboradorId String
  periodoInicio DateTime
  periodoFin    DateTime
  diasAsistidos Int
  sueldoPeriodo Float
  pagada        Boolean  @default(false)
  fechaPago     DateTime?

  generadoPor   User    @relation("NominaGeneradoPor", fields: [generadoPorId], references: [id])
  generadoPorId String
  pagadoPor     User?   @relation("NominaPagadaPor", fields: [pagadoPorId], references: [id])
  pagadoPorId   String?

  createdAt DateTime @default(now())

  @@index([colaboradorId])
}

// --- Módulo Sistemas / TI ------------------------------------------------
// Especificación, sección 3.11: soporte técnico + control de activos de
// cómputo, conectado con Vigilancia para la salida física de esos activos.

enum CategoriaTicket {
  HARDWARE
  SOFTWARE
  RED
  OTRO
}

enum PrioridadTicket {
  BAJA
  MEDIA
  ALTA
}

enum EstadoTicket {
  ABIERTO
  RESUELTO
}

model TicketSoporte {
  id        String          @id @default(cuid())
  folio     String          @unique // TK-0001
  titulo    String
  categoria CategoriaTicket
  prioridad PrioridadTicket @default(MEDIA)
  estado    EstadoTicket    @default(ABIERTO)

  reportadoPor   User    @relation("TicketReportadoPor", fields: [reportadoPorId], references: [id])
  reportadoPorId String
  resueltoPor    User?   @relation("TicketResueltoPor", fields: [resueltoPorId], references: [id])
  resueltoPorId  String?

  createdAt  DateTime  @default(now())
  resueltoAt DateTime?

  @@index([estado])
}

enum TipoDispositivo {
  LAPTOP
  DESKTOP
  MONITOR
  CELULAR
  OTRO
}

// "Mis Dispositivos" de la especificación: aquí Sistemas/TI da de alta y
// asigna el equipo; no hay todavía una vista de autoservicio por colaborador
// en cada módulo (ver notas del README).
model Dispositivo {
  id          String          @id @default(cuid())
  codigo      String          @unique // DI-AAAA-XXX
  tipo        TipoDispositivo
  marca       String
  modelo      String
  numeroSerie String?
  activo      Boolean         @default(true)

  colaborador     User?     @relation("DispositivoColaborador", fields: [colaboradorId], references: [id])
  colaboradorId   String?
  fechaAsignacion DateTime?

  asignadoPor   User   @relation("DispositivoAsignadoPor", fields: [asignadoPorId], references: [id])
  asignadoPorId String

  createdAt DateTime @default(now())

  vales ValeSalida[]

  @@index([colaboradorId])
}
